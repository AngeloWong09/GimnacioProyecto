@page "/ClienteClase"


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GYM FAST FORCE!</title>
    <link rel="stylesheet" href="styles.css" />
</head>
<body>

    <!-- Botón Volver al Menú como enlace -->
    <div>
        <a href="/Cliente" class="button">Volver al Menú</a>
    </div>

    <h1 class="title">GYM FAST FORCE</h1>

    <!-- Contenedor de botones para cargar diferentes tipos de CSV -->
    <div>
        <button onclick="mostrarDatos('Clases')">Mostrar Clases</button>
        <button onclick="mostrarDatos('Entrenadores')">Mostrar Entrenadores</button>
    </div>
    <br />

    <p>Haz clic en los campos de la tabla.</p>

    <!-- Tabla para mostrar los datos CSV cargados -->
    <table id="csvTable" border="1" style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr>
                <th>Num Clase</th>
                <th>ID Clase</th>
                <th>ID Entrenador</th>
                <th>Clase</th>
                <th>Fecha</th>
                <th>Horario</th>
                <th>Cupos</th>
                <th>Precio Clase</th>
            </tr>
        </thead>
        <tbody id="csvTableBody"></tbody>
    </table>

    <br />

    <!-- Tabla para mostrar los datos de Entrenadores -->
    <table id="csvTableEntrenadores" border="1" style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Contraseña</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>ID</th>
                <th>Puntos fuertes</th>
            </tr>
        </thead>
        <tbody id="csvTableBodyEntrenadores"></tbody>
    </table>

    <br />

    <p id="currentTime"></p>

    <script src="script.js"></script>
    <script>
        let datosCSV = [];
        let datosEntrenadores = [];

        // Cargar archivo CSV
        async function cargarCSV(tipo) {
            let ruta;
            const timestamp = new Date().getTime();

            if (tipo === 'Clases') {
                ruta = `/sample-data/Clases.csv?${timestamp}`;
            } else if (tipo === 'Entrenadores') {
                ruta = `/sample-data/Entrenadores.csv?${timestamp}`;
            }

            try {
                const respuesta = await fetch(ruta);
                if (!respuesta.ok) {
                    alert("No se pudo cargar el archivo " + tipo + ".csv.");
                    return;
                }
                const contenido = await respuesta.text();
                if (tipo === 'Entrenadores') {
                    procesarCSVEntrenadoresTexto(contenido);
                } else {
                    procesarCSVTexto(contenido);
                }
            } catch (error) {
                alert("Hubo un problema al cargar el archivo.");
                console.error("Error al cargar el archivo", error);
            }
        }

        function procesarCSVTexto(texto) {
            const lineas = texto.split("\n").filter((linea, index) => index > 0 && linea.trim() !== "");
            datosCSV = lineas.map(linea => linea.split(";"));
            actualizarTablaClases();
        }

        function procesarCSVEntrenadoresTexto(texto) {
            const lineas = texto.split("\n").filter((linea, index) => index > 0 && linea.trim() !== "");
            datosEntrenadores = lineas.map(linea => linea.split(";"));
            actualizarTablaEntrenadores();
        }

        function actualizarTablaClases() {
            const tablaBody = document.getElementById("csvTableBody");
            tablaBody.innerHTML = "";
            datosCSV.forEach(fila => {
                const filaTabla = document.createElement("tr");
                fila.forEach(columna => {
                    const celda = document.createElement("td");
                    celda.textContent = columna.trim();
                    filaTabla.appendChild(celda);
                });
                tablaBody.appendChild(filaTabla);
            });
        }

        function actualizarTablaEntrenadores() {
            const tablaBody = document.getElementById("csvTableBodyEntrenadores");
            tablaBody.innerHTML = "";
            datosEntrenadores.forEach(fila => {
                const filaTabla = document.createElement("tr");
                fila.forEach(columna => {
                    const celda = document.createElement("td");
                    celda.textContent = columna.trim();
                    filaTabla.appendChild(celda);
                });
                tablaBody.appendChild(filaTabla);
            });
        }

        function mostrarDatos(tipo) {
            cargarCSV(tipo);
        }
    </script>
</body>
</html>
